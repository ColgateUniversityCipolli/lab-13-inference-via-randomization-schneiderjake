"", breaks = c("Observation", "Mirror", "Null", "Alternative"),
values = c("Observation" = "red",
"Mirror"      = "red4",
"Null"        = "black",
"Alternative" = "grey60")
) +
scale_x_continuous(
name   = expression(italic(t)),
limits = {m <- max(abs(c(resamples$tstats, resamples$tstats.shifted)));
c(-1.1 * m, 1.1 * m)},
breaks = pretty(c(-1, 1) * m, n = 7)
) +
ylab("Density") +
ggtitle("Bootstrap Hypothesis Test (T-Statistic)") +
theme_bw() +
theme(legend.position = "right")
bootstrap.plot.closer.tstat
R <- 100000
n <- nrow(finch.dat)
s <- sd(finch.dat$closer)
resamples <- tibble(tstats = rep(NA, R))
for(i in 1:R){
curr.resample <- sample(finch.dat$closer,
size = n,
replace = TRUE)
resamples$tstats[i] <- (mean(curr.resample) - 0) / (s / sqrt(n))
}
# No longer a confidence interval for x̄ — this is for the T-statistic distribution
# Shift so H0 is true (centered at 0)
(delta <- mean(resamples$tstats))
resamples <- resamples |>
mutate(tstats.shifted = tstats - delta)
# Use observed t-stat from original data
obs_t <- (mean(finch.dat$closer) - 0) / (s / sqrt(n))
low <- -abs(obs_t)
high <- abs(obs_t)
resamples |>
summarize(mean = mean(tstats.shifted),
p.low = mean(tstats.shifted <= low),
p.high = mean(tstats.shifted >= high))|>
mutate(p = p.low + p.high) |>
view()
# Plot the Bootstrap Test
ggdat.obs <- tibble(xbar = obs_t,
y = 0) |>
mutate(mirror = -xbar)  # reflection around 0 for two-sided
x_max <- 1.1 * max(abs(c(resamples$tstats,
resamples$tstats.shifted)))
## two-sided cutoff
t_cut <- abs(obs_t)            # |t-obs|
## density of the null
dens_null <- density(resamples$tstats.shifted)
dens_null <- tibble(x = dens_null$x, y = dens_null$y)
bootstrap.plot.closer.tstat <- ggplot() +
## -------- rejection region under the *null* density ---------------
geom_area(data = filter(dens_null, x <= -t_cut),
aes(x, y), fill = "salmon", alpha = .30) +
geom_area(data = filter(dens_null, x >=  t_cut),
aes(x, y), fill = "salmon", alpha = .30) +
## -------- existing layers -----------------------------------------
stat_density(data = resamples,
aes(x = tstats.shifted, colour = "Null"), linewidth = .8) +
stat_density(data = resamples,
aes(x = tstats,         colour = "Alternative"), linewidth = .8) +
geom_hline(yintercept = 0) +
geom_point(data = ggdat.obs,
aes(x = xbar,   y = y, colour = "Observation"), size = 3) +
geom_point(data = ggdat.obs,
aes(x = mirror, y = y, colour = "Mirror"),      size = 3) +
## colours / legend
scale_colour_manual(
"", breaks = c("Observation", "Mirror", "Null", "Alternative"),
values = c("Observation" = "red",
"Mirror"      = "red4",
"Null"        = "black",
"Alternative" = "grey60")
) +
## axis & theme
scale_x_continuous(
name   = expression(italic(t)),
limits = c(-x_max, x_max),
breaks = pretty(c(-x_max, x_max), n = 7)
) +
ylab("Density") +
ggtitle("Bootstrap Hypothesis Test (T-Statistic)") +
theme_bw() +
theme(legend.position = "right")
bootstrap.plot.closer.tstat
